# Copy to service/.env and fill real values — .env is gitignored, NEVER commit it.
DATABASE_URL=postgresql://radar:radar@localhost:5432/journal
SESSION_SECRET=            # openssl rand -base64 32 (dev value, different from prod)
GOOGLE_CLIENT_ID=          # Google Cloud Console → OAuth client (same as prod is fine)
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=         # Claude API key for AI journal validation (backlog #20) — set the real value in .env locally and in Railway Variables
ANTHROPIC_MODEL=           # optional — overrides the default "claude-sonnet-5" (see claude.client.ts). Change + restart, no redeploy needed.
WEB_ORIGIN=http://localhost:3000  # the Next.js app's own origin — OAuth redirect_uri is built as ${WEB_ORIGIN}/api/journal/auth/callback so it always goes through the rewrite proxy, keeping the session cookie first-party. ALSO used by yahoo-price.ts to fetch prices via ${WEB_ORIGIN}/api/prices — Yahoo Finance blocks/rate-limits Railway's IPs, so trade validation routes price lookups through the Vercel app's egress instead. In Railway, set this to the real production domain (e.g. https://stockplaybook.app), not localhost.
PORT=4000
LOG_FORMAT=pretty          # pretty (default, colorized single-line) | json (structured, for filtering at scale)
VALIDATE_IP_LIMIT=10       # optional — max AI journal-validate calls per IP within VALIDATE_IP_WINDOW_HOURS, regardless of account (default 10). Blocks account-switching abuse of the free 3-call quota.
VALIDATE_IP_WINDOW_HOURS=24 # optional — rolling window in hours for VALIDATE_IP_LIMIT (default 24)
