# Copy to service/.env and fill real values — .env is gitignored, NEVER commit it.
DATABASE_URL=postgresql://radar:radar@localhost:5432/journal
SESSION_SECRET=            # openssl rand -base64 32 (dev value, different from prod)
GOOGLE_CLIENT_ID=          # Google Cloud Console → OAuth client (same as prod is fine)
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=         # Claude API key for AI journal validation (backlog #20) — set the real value in .env locally and in Railway Variables
ANTHROPIC_MODEL=           # optional — overrides the default "claude-sonnet-5" (see claude.client.ts). Change + restart, no redeploy needed.
WEB_ORIGIN=http://localhost:3000  # the Next.js app's own origin — OAuth redirect_uri is built as ${WEB_ORIGIN}/api/journal/auth/callback so it always goes through the rewrite proxy, keeping the session cookie first-party
PORT=4000
LOG_FORMAT=pretty          # pretty (default, colorized single-line) | json (structured, for filtering at scale)
