generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String?
  avatarUrl      String?        @map("avatar_url")
  role           String         @default("user")
  status         String         @default("active")
  createdAt      DateTime       @default(now()) @map("created_at")
  authIdentities AuthIdentity[]
  trades         Trade[]
  validationRequests ValidationRequest[]

  @@map("users")
}

model AuthIdentity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  provider  String
  subject   String
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, subject])
  @@map("auth_identities")
}

// id is a plain String (not @db.Uuid) so legacy non-UUID slugs imported
// from private/journal.json (e.g. "mqo1lokf25w6") can be inserted verbatim.
model Trade {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  user             User        @relation(fields: [userId], references: [id])
  ticker           String
  catalystType     String      @map("catalyst_type")
  linkedReportDate String?     @map("linked_report_date")
  entryPrice       Float       @map("entry_price")
  shares           Float
  entryDate        DateTime    @map("entry_date") @db.Date
  plannedTP        Json        @map("planned_tp")
  plannedSL        Float       @map("planned_sl")
  // Optional structural "hard" stop below the tight stop (plannedSL). When set,
  // the AI validator may recommend holding to it after the tight stop breaks
  // (CLI analyze-journal "HOLD TO HARD STOP" flow); null = tight stop is final.
  plannedHardSL    Float?      @map("planned_hard_sl")
  status           String
  realizedPnL      Float?      @map("realized_pnl")
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")
  exits            TradeExit[]
  validation       TradeValidation?

  @@map("trades")
}

model TradeExit {
  id      String   @id @default(uuid())
  tradeId String   @map("trade_id")
  trade   Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  price   Float
  shares  Float
  note    String?

  @@map("trade_exits")
}

model Plan {
  id          String        @id
  name        String
  priceCents  Int?          @map("price_cents")
  interval    String?
  planFeatures PlanFeature[]

  @@map("plans")
}

model Feature {
  id           String        @id
  name         String
  description  String?
  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  planId     String  @map("plan_id")
  featureId  String  @map("feature_id")
  plan       Plan    @relation(fields: [planId], references: [id])
  feature    Feature @relation(fields: [featureId], references: [id])
  enabled    Boolean @default(true)
  limitValue Int?    @map("limit_value")

  @@id([planId, featureId])
  @@map("plan_features")
}

model ValidationRequest {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id])
  requestedAt  DateTime  @default(now()) @map("requested_at")
  status       String    // pending | done | failed
  tradesCount  Int       @map("trades_count")
  model        String
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  // Real client IP (see common/client-ip.ts) — backs the IP-based rate limit
  // that catches account-switching abuse the per-user quota alone can't.
  ip           String?

  @@index([ip, requestedAt])
  @@map("validation_requests")
}

model TradeValidation {
  tradeId      String   @id @map("trade_id")
  trade        Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  verdict      String   // HOLD | CUT | WATCH
  thesisIntact Boolean  @map("thesis_intact")
  // Stop flags / buffer / color are computed by code (validation/trade-rules.ts),
  // never taken from the model. tightStopBreached reuses the original
  // stop_breached column (it always meant price <= plannedSL).
  tightStopBreached Boolean @map("stop_breached")
  hardStopBreached  Boolean @default(false) @map("hard_stop_breached")
  atRisk       Boolean  @map("at_risk")
  slBufferPct  Float?   @map("sl_buffer_pct")
  addMore      String?  @map("add_more") // BUY_DIP | WAIT | DONT_ADD
  stopDecision String?  @map("stop_decision") // HOLD_TO_HARD_STOP | CUT_NOW | EXIT_IMMEDIATELY (only when tight stop breached)
  summary      String
  summaryTh    String   @default("") @map("summary_th")
  action       String
  actionTh     String   @default("") @map("action_th")
  color        String   // green | yellow | red
  validatedAt  DateTime @default(now()) @map("validated_at")

  @@map("trade_validations")
}
